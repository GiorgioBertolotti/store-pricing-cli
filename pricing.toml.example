# store-pricing-cli configuration.
# Uncomment/edit any value below to override the built-in default.
#
# This file is a reference copy - `python pricing.py` generates a live, gitignored
# pricing.toml on first run if one doesn't exist yet.

[pricing]
# Country the scaling factor is anchored to - it always pays the full USD price.
anchor_country = "United States"
# Scaling factor cap: countries pricier than the anchor pay full price, never a premium.
scaling_cap = 1.0
# Scaling factor floor: no country is discounted below this share of the anchor's price.
# Guards against PPP data errors (e.g. a factor reported in a different currency). 0 = off.
min_scaling_factor = 0.0
# VAT/GST rate applied to countries not listed in [pricing.vat] below.
default_vat = 0.15
# "psychological" (round to .99-style endings), "psychological-half" (.49 or .99) or
# "none" (raw computed price).
rounding = "psychological"

[pricing.vat]
# Per-country overrides of the built-in VAT/GST table, e.g.:
# Germany = 0.19

# Market price ratios per plan (`--plan weekly|monthly|annual`): what users in a country
# actually pay for that plan length, tax included, relative to the anchor country's price.
# A country listed here skips PPP scaling and VAT is not added on top (the ratio already
# includes it); everyone else falls back to PPP. Names are World Bank country names. E.g.:
# [pricing.market_ratio.annual]
# Italy = 1.05
# Japan = 0.95
# Optional ceiling on any market ratio, e.g. 1.25 = never more than 125% of the anchor's
# tax-inclusive price (set under [pricing], above the tables):
# market_ratio_cap = 1.25

# Rounding override per plan (`--plan`), e.g. .49/.99 endings for a cheap monthly plan
# where a whole-unit step is a large share of the price:
# [pricing.plan_rounding]
# monthly = "psychological-half"

[apple]
# get_closest_price_point() skips a territory if the nearest available price point
# differs from the target by more than this fraction of the target price...
price_point_tolerance_pct = 0.10
# ...or by more than this many units of local currency, whichever is larger.
price_point_tolerance_units = 2.0
# Concurrent HTTP round-trips for price-point resolution. Kept modest against
# Apple's undocumented rate limits.
max_workers = 8

[data]
# "auto" walks back from the current year until the World Bank has PPP data.
# Set to a specific year (e.g. 2024) to pin it.
ppp_year = "auto"
