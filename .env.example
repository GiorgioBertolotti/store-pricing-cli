# Reference copy of the variables `python pricing.py setup` writes for you.
# You normally don't need this file - run the wizard instead, since it validates each
# value against the real API as you enter it. It's kept for CI, where these are injected
# as environment variables rather than written to a .env file.
#
# Every `your_*` value below is rejected as a placeholder, so copying this file verbatim
# reports as "not configured" instead of failing later with an opaque API error.

# Google Play Console Configuration
GOOGLE_SERVICE_ACCOUNT_FILE=your_path_to_the_service_account_json
GOOGLE_PACKAGE_NAME=your_app_package_name
# Subscription - omit these two if you're only pricing a one-time product.
GOOGLE_SUBSCRIPTION_ID=your_subscription_id
GOOGLE_BASEPLAN_ID=your_base_plan_id
# One-time (managed) product - omit these two if you're only pricing a subscription.
# Both can be set alongside the subscription vars above to price both independently.
GOOGLE_ONETIME_PRODUCT_ID=your_onetime_product_id
GOOGLE_ONETIME_PURCHASE_OPTION_ID=your_purchase_option_id

# App Store Connect Configuration
APPLE_ISSUER_ID=your_issuer_id
APPLE_KEY_ID=your_api_key_id
# Full .p8 contents on a single line, with a literal \n between the PEM lines.
APPLE_PRIVATE_KEY=your_private_key_content_here
# The numeric App ID - not the bundle ID, and not the subscription group ID.
APPLE_APP_ID=your_numeric_app_id
# Subscription - omit if you're only pricing a one-time in-app purchase.
APPLE_SUBSCRIPTION_PRODUCT_ID=your_subscription_product_id
# One-time in-app purchase - omit if you're only pricing a subscription. Can be set
# alongside APPLE_SUBSCRIPTION_PRODUCT_ID to price both independently.
APPLE_IAP_PRODUCT_ID=your_iap_product_id

# Stripe Configuration
# Secret key (sk_...) or a restricted key (rk_...) with write access to Prices, Coupons
# and Promotion codes.
STRIPE_SECRET_KEY=your_stripe_secret_key
# Subscription - the recurring Price ID (Dashboard -> Product catalog). Omit if you're
# only pricing a one-time Price.
STRIPE_PRICE_ID=your_stripe_price_id
# One-time Price (type=one_time) - omit if you're only pricing a subscription. Can be set
# alongside STRIPE_PRICE_ID to price both independently; both share STRIPE_SECRET_KEY.
STRIPE_ONETIME_PRICE_ID=your_stripe_onetime_price_id
